            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden", "-Command", "& (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\scripts\\check-exercises.ps1')"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden", "-Command", "& (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\scripts\\detect-stuck.ps1')"]
          }

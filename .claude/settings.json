          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden", "-Command", "& (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\scripts\\auto-save-progress.ps1')"]
